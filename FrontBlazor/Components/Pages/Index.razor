@page "/"
@inject NavigationManager Navigation
@rendermode InteractiveServer

@code {
    private void IrAlLogin()
    {
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}

<PageTitle>Sistema de Gestión</PageTitle>

<div class="welcome-container">
    <div class="welcome-content">
        <h1 class="display-4">Sistema de Gestión de Proyectos</h1>
        <p class="lead">Bienvenido al sistema de gestión integral de proyectos</p>
        <div class="welcome-actions">
            <button class="btn btn-primary btn-lg me-3" @onclick="IrAlLogin">
                <i class="oi oi-account-login me-2"></i>Iniciar Sesión
            </button>
        </div>
    </div>
</div>



<style>
    .welcome-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
        position: relative;
        overflow: hidden;
    }

    .welcome-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="grid" width="100" height="100" patternUnits="userSpaceOnUse"><path d="M 100 0 L 0 0 0 100" fill="none" stroke="white" stroke-width="0.5" opacity="0.05"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
        opacity: 0.3;
    }

    .welcome-content {
        background: #2b2b2b;
        border-radius: 20px;
        padding: 60px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
        text-align: center;
        position: relative;
        z-index: 1;
        max-width: 700px;
        width: 100%;
        margin: 20px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .welcome-icon {
        font-size: 100px;
        color: #e0e0e0;
        margin-bottom: 30px;
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-15px);
        }
    }

    .welcome-content h1 {
        color: #e0e0e0;
        margin-bottom: 20px;
        font-weight: 700;
        font-size: 2.5rem;
    }

    .welcome-content .lead {
        color: #a0a0a0;
        margin-bottom: 40px;
        font-size: 1.2rem;
    }

    .welcome-actions {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .btn-welcome-primary {
        min-width: 180px;
        padding: 15px 30px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        background: linear-gradient(135deg, #5a7fc7 0%, #7a9fd9 100%);
        border: none;
        color: white;
        box-shadow: 0 4px 15px rgba(90, 127, 199, 0.4);
    }

    .btn-welcome-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(90, 127, 199, 0.6);
        background: linear-gradient(135deg, #6a8fd7 0%, #8aafe9 100%);
    }

    .btn-welcome-secondary {
        min-width: 180px;
        padding: 15px 30px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid #4a4a4a;
        color: #e0e0e0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .btn-welcome-secondary:hover {
        background: rgba(255, 255, 255, 0.15);
        border-color: #7a7a7a;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
        color: #ffffff;
    }

    .btn-welcome-primary:active,
    .btn-welcome-secondary:active {
        transform: translateY(0);
    }

    .welcome-footer {
        margin-top: 40px;
        padding-top: 30px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        color: #666;
        font-size: 0.9rem;
    }

    .feature-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 40px;
    }

    .feature-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 20px;
        transition: all 0.3s ease;
    }

    .feature-card:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    }

    .feature-card i {
        font-size: 2.5rem;
        color: #7a9fd9;
        margin-bottom: 15px;
    }

    .feature-card h3 {
        color: #e0e0e0;
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .feature-card p {
        color: #a0a0a0;
        font-size: 0.85rem;
        margin: 0;
    }

    @@media (max-width: 768px) {
        .welcome-content {
            padding: 40px 30px;
        }

        .welcome-content h1 {
            font-size: 2rem;
        }

        .welcome-icon {
            font-size: 70px;
        }

        .welcome-actions {
            flex-direction: column;
            align-items: center;
        }

        .btn-welcome-primary,
        .btn-welcome-secondary {
            width: 100%;
            max-width: 280px;
        }

        .feature-cards {
            grid-template-columns: 1fr;
        }
    }
</style>
