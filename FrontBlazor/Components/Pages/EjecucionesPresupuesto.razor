@page "/ejecuciones_presupuesto"

@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@using System.Text.Json
@inject IHttpClientFactory fabricaHttp
@using FrontendBlazorApi.Servicios
@inject ServicioApiGenerico servicioApi
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Ejecución de Presupuestos</PageTitle>

<h3>Gestión de Ejecución de Presupuestos</h3>

<div class="mb-3 d-flex gap-2">
    <button class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button class="btn btn-outline-primary" @onclick="CargarEjecuciones">Mostrar todos</button>
    <button class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>

<div class="mb-3">
    <label for="idBusqueda">Buscar por ID:</label>
    <InputNumber id="idBusqueda" @bind-Value="idBusqueda" class="form-control" />
    <button class="btn btn-primary mt-2" @onclick="BuscarEjecucion">Buscar</button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso" role="alert">@mensaje</div>
}

<h4>Formulario de Ejecución</h4>

<EditForm Model="ejecucionActual" OnValidSubmit="GuardarSegunEjecucion" FormName="EjecucionForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label fw-bold">Presupuesto</label>
            <InputSelect class="form-select" @bind-Value="ejecucionActual.IdPresupuesto">
                <option value="0">-- Seleccione --</option>
                @foreach (var p in listaPresupuestos)
                {
                    <option value="@p.Id">@p.Id - @p.MontoSolicitado.ToString("C")</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-3">
            <label class="form-label">Año</label>
            <InputNumber class="form-control" @bind-Value="ejecucionActual.Anio" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Monto Planeado</label>
            <InputNumber class="form-control" @bind-Value="ejecucionActual.MontoPlaneado" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Monto Ejecutado</label>
            <InputNumber class="form-control" @bind-Value="ejecucionActual.MontoEjecutado" />
        </div>

        <div class="col-md-12">
            <label class="form-label">Observaciones</label>
            <InputTextArea class="form-control" @bind-Value="ejecucionActual.Observaciones" rows="2" />
        </div>
    </div>

    <div class="mt-3 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarEjecucion" disabled="@(!existeEjecucion)">Eliminar</button>
    </div>
</EditForm>

<hr />

@if (cargando)
{
    <div class="table-loading">Cargando Ejecuciones...</div>
}
else if (listaEjecuciones.Count == 0)
{
    <div class="alert alert-info"><strong>ℹ️</strong> No hay Ejecuciones disponibles.</div>
}
else
{
    <div class="table-container">
        <table class="table table-striped text-white">
            <thead>
                <tr>
                    <th>Presupuesto</th>
                    <th>Año</th>
                    <th>Monto Planeado</th>
                    <th>Monto Ejecutado</th>
                    <th>Observaciones</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in listaEjecuciones)
                {
                    <tr>
                        <td>@listaPresupuestos.FirstOrDefault(p => p.Id == e.IdPresupuesto)?.MontoSolicitado.ToString("C")</td>
                        <td>@e.Anio</td>
                        <td>@e.MontoPlaneado?.ToString("C")</td>
                        <td>@e.MontoEjecutado?.ToString("C")</td>
                        <td>@e.Observaciones</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="@(() => CargarEnFormulario(e))">Cargar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<EjecucionPresupuesto> listaEjecuciones = new();
    private List<Presupuesto> listaPresupuestos = new();
    private EjecucionPresupuesto ejecucionActual { get; set; } = new();

    private bool existeEjecucion = false;
    private string textoBotonGuardar = "Crear";

    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;

    private const string urlBaseApi = "api/ejecucionpresupuesto";
    private const string urlProcedimientos = "api/procedimientos/ejecutarsp";
    private const string urlPresupuesto = "api/presupuesto";

    private int idBusqueda;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarEjecuciones();
            await CargarPresupuestos();
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task CargarPresupuestos()
    {
        try
        {
            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Presupuesto>>>(urlPresupuesto);
            listaPresupuestos = respuesta?.Datos ?? new();
        }
        catch { }
    }

    private async Task CargarEjecuciones()
    {
        try
        {
            cargando = true;
            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<EjecucionPresupuesto>>>(urlBaseApi);
            listaEjecuciones = respuesta?.Datos ?? new();
            mensaje = $"Se cargaron {listaEjecuciones.Count} Ejecución(es).";
            claseAviso = "alert alert-success";
        }
        catch (Exception e)
        {
            mensaje = $"Error al listar Ejecuciones: {e.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarEjecucion()
    {
        try
        {
            var consulta = new
            {
                consulta = "SELECT * FROM EjecucionPresupuesto WHERE Id = @Id",
                parametros = new { Id = idBusqueda }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.PostAsJsonAsync("api/consultas/ejecutarconsultaparametrizada", consulta);

            if (respuesta.IsSuccessStatusCode)
            {
                var resultado = await respuesta.Content.ReadFromJsonAsync<JsonElement>();
                if (resultado.TryGetProperty("resultados", out var datos) && datos.GetArrayLength() > 0)
                {
                    var e = datos[0];
                    ejecucionActual = new EjecucionPresupuesto
                    {
                        Id = e.GetProperty("Id").GetInt32(),
                        IdPresupuesto = e.GetProperty("IdPresupuesto").GetInt32(),
                        Anio = e.GetProperty("Anio").GetInt32(),
                        MontoPlaneado = e.TryGetProperty("MontoPlaneado", out var mp) ? mp.GetDecimal() : null,
                        MontoEjecutado = e.TryGetProperty("MontoEjecutado", out var me) ? me.GetDecimal() : null,
                        Observaciones = e.TryGetProperty("Observaciones", out var obs) ? obs.GetString() : null
                    };

                    existeEjecucion = true;
                    textoBotonGuardar = "Actualizar";
                    claseAviso = "alert alert-success";
                }
                else
                {
                    mensaje = "Ejecución no encontrada.";
                    claseAviso = "alert alert-warning";
                }
            }
            else
            {
                mensaje = $"Error al buscar Ejecución: {respuesta.ReasonPhrase}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al buscar Ejecución: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task GuardarSegunEjecucion()
    {
        if (existeEjecucion)
            await ActualizarEjecucion();
        else
            await CrearEjecucion();
    }

    private async Task CrearEjecucion()
    {
        try
        {
            var parametros = new Dictionary<string, object?>
            {
                { "nombreSP", "sp_InsertarEjecucionPresupuesto" },
                { "@IdPresupuesto", ejecucionActual.IdPresupuesto },
                { "@Anio", ejecucionActual.Anio },
                { "@MontoPlaneado", ejecucionActual.MontoPlaneado },
                { "@MontoEjecutado", ejecucionActual.MontoEjecutado },
                { "@Observaciones", ejecucionActual.Observaciones }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.PostAsJsonAsync(urlProcedimientos, parametros);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "✅ Ejecución insertada exitosamente.";
                claseAviso = "alert alert-success";
                await CargarEjecuciones();
                LimpiarFormulario();
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"❌ Error al ejecutar SP: {error}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"❌ Error al crear Ejecución: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ActualizarEjecucion()
    {
        if (ejecucionActual.Id <= 0)
        {
            mensaje = "Debe seleccionar una ejecución válida para actualizar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var parametros = new Dictionary<string, object?>
            {
                { "nombreSP", "sp_ActualizarEjecucionPresupuesto" },
                { "@Id", ejecucionActual.Id },
                { "@IdPresupuesto", ejecucionActual.IdPresupuesto },
                { "@Anio", ejecucionActual.Anio },
                { "@MontoPlaneado", ejecucionActual.MontoPlaneado },
                { "@MontoEjecutado", ejecucionActual.MontoEjecutado },
                { "@Observaciones", ejecucionActual.Observaciones }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.PostAsJsonAsync(urlProcedimientos, parametros);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "✅ Ejecución actualizada exitosamente.";
                claseAviso = "alert alert-success";
                await CargarEjecuciones();
                LimpiarFormulario();
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"❌ Error al actualizar Ejecución: {error}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"❌ Error al ejecutar procedimiento de actualización: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task EliminarEjecucion()
    {
        if (ejecucionActual.Id <= 0)
        {
            mensaje = "Debe seleccionar una ejecución válida para eliminar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            // Diccionario con nombre del SP y parámetro Id
            var parametros = new Dictionary<string, object?>
            {
                { "nombreSP", "sp_EliminarEjecucionPresupuesto" },
                { "@Id", ejecucionActual.Id }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.PostAsJsonAsync(urlProcedimientos, parametros);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "✅ Ejecución eliminada correctamente (SP ejecutado).";
                claseAviso = "alert alert-success";

                // Refrescar la lista y limpiar formulario
                await CargarEjecuciones();
                LimpiarFormulario();
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"❌ Error al eliminar ejecución: {error}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"❌ Error al ejecutar procedimiento de eliminación: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ProbarConexion()
    {
        try
        {
            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.GetAsync(urlBaseApi);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "✅ Conexión exitosa con la API.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = "❌ Error: Endpoint no disponible.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private void CargarEnFormulario(EjecucionPresupuesto e)
    {
        ejecucionActual = new EjecucionPresupuesto
        {
            Id = e.Id,
            IdPresupuesto = e.IdPresupuesto,
            Anio = e.Anio,
            MontoPlaneado = e.MontoPlaneado,
            MontoEjecutado = e.MontoEjecutado,
            Observaciones = e.Observaciones
        };

        existeEjecucion = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Ejecución cargada en el formulario.";
        claseAviso = "alert alert-info";
    }

    private void LimpiarFormulario()
    {
        ejecucionActual = new EjecucionPresupuesto();
        existeEjecucion = false;
        textoBotonGuardar = "Crear";
        mensaje = "";
        claseAviso = "alert alert-info";
    }
}
