@code {
    // Variables de estado
    private List<Rol> roles = new();
    private Rol rolActual = new();
    private bool cargando = false;
    private bool modoEdicion = false;
    private string mensaje = string.Empty;
    private string estiloMensaje = "alert-info";
    private string iconoMensaje = "bi-info-circle";
    private string filtroTexto = string.Empty;

    // Propiedad computada para filtrar roles
    private IEnumerable<Rol> RolesFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filtroTexto))
                return roles;

            var filtro = filtroTexto.ToLower();
            return roles.Where(r => r.Nombre.ToLower().Contains(filtro));
        }
    }

    protected override async Task OnAutenticacionVerificada()
    {
        // Este método se llama automáticamente después de verificar la autenticación
        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        await CargarRoles();
    }

    private async Task CargarRoles()
    {
        try
        {
            cargando = true;

            // Ejecutar stored procedure sp_SeleccionarRol sin parámetros para obtener todos
            var parametros = new { Id = (int?)null };
            var resultado = await servicioApi.EjecutarStoredProcedureConResultadosAsync("sp_SeleccionarRol", parametros);

            if (resultado?.Resultados != null && resultado.Resultados.Any())
            {
                roles = resultado.Resultados.Select(r => new Rol
                {
                    Id = ObtenerInt(r, "id"),
                    Nombre = ObtenerString(r, "nombre")
                }).ToList();

                if (!string.IsNullOrEmpty(mensaje))
                    MostrarMensaje($"Se cargaron {roles.Count} roles", "success");
            }
            else
            {
                roles = new List<Rol>();
                if (string.IsNullOrEmpty(mensaje))
                    MostrarMensaje("No hay roles registrados", "info");
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al cargar roles: {ex.Message}", "danger");
            roles = new List<Rol>();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarRol()
    {
        try
        {
            cargando = true;

            // Validación
            if (string.IsNullOrWhiteSpace(rolActual.Nombre))
            {
                MostrarMensaje("Por favor ingrese el nombre del rol", "warning");
                return;
            }

            if (modoEdicion)
            {
                // ACTUALIZAR ROL EXISTENTE
                var confirmacion = await JS.InvokeAsync<bool>("confirm",
                    $"¿Está seguro de actualizar el rol '{rolActual.Nombre}'?");

                if (!confirmacion) return;

                // Preparar parámetros para sp_ActualizarRol
                var parametros = new
                {
                    Id = rolActual.Id,
                    Nombre = rolActual.Nombre
                };

                await servicioApi.EjecutarStoredProcedureAsync("sp_ActualizarRol", parametros);
                MostrarMensaje($"✓ Rol '{rolActual.Nombre}' actualizado exitosamente", "success");
            }
            else
            {
                // CREAR NUEVO ROL
                var parametros = new
                {
                    Nombre = rolActual.Nombre
                };

                await servicioApi.EjecutarStoredProcedureAsync("sp_InsertarRol", parametros);
                MostrarMensaje($"✓ Rol '{rolActual.Nombre}' creado exitosamente", "success");
            }

            await CargarRoles();
            LimpiarFormulario();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al guardar rol: {ex.Message}", "danger");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task EliminarRol(int id)
    {
        try
        {
            var rolAEliminar = roles.FirstOrDefault(r => r.Id == id);
            if (rolAEliminar == null)
            {
                MostrarMensaje("Rol no encontrado", "danger");
                return;
            }

            var confirmacion = await JS.InvokeAsync<bool>("confirm",
                $"¿Está seguro de eliminar el rol '{rolAEliminar.Nombre}'?\n\n" +
                $"ADVERTENCIA: Esta acción eliminará también:\n" +
                $"• Todas las asignaciones de este rol a usuarios\n" +
                $"• Todos los permisos asociados a este rol\n\n" +
                $"Esta acción no se puede deshacer.");

            if (!confirmacion) return;

            cargando = true;

            // Ejecutar sp_EliminarRol
            var parametros = new { Id = id };
            await servicioApi.EjecutarStoredProcedureAsync("sp_EliminarRol", parametros);

            MostrarMensaje($"✓ Rol '{rolAEliminar.Nombre}' eliminado exitosamente", "success");
            await CargarRoles();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al eliminar rol: {ex.Message}", "danger");
        }
        finally
        {
            cargando = false;
        }
    }

    private void CargarParaEditar(Rol rol)
    {
        rolActual = new Rol
        {
            Id = rol.Id,
            Nombre = rol.Nombre
        };
        modoEdicion = true;
        mensaje = string.Empty;
    }

    private void LimpiarFormulario()
    {
        rolActual = new Rol();
        modoEdicion = false;
        mensaje = string.Empty;
    }

    private void MostrarMensaje(string texto, string tipo)
    {
        mensaje = texto;
        estiloMensaje = tipo switch
        {
            "success" => "alert-success",
            "danger" => "alert-danger",
            "warning" => "alert-warning",
            _ => "alert-info"
        };
        iconoMensaje = tipo switch
        {
            "success" => "bi-check-circle",
            "danger" => "bi-exclamation-triangle",
            "warning" => "bi-exclamation-circle",
            _ => "bi-info-circle"
        };
    }

    private string ObtenerString(Dictionary<string, object> dict, string key)
    {
        if (!dict.TryGetValue(key, out var valor)) return "";
        if (valor is JsonElement elem)
            return elem.ValueKind == JsonValueKind.String ? elem.GetString() ?? "" : elem.ToString();
        return valor?.ToString() ?? "";
    }

    private int ObtenerInt(Dictionary<string, object> dict, string key)
    {
        if (!dict.TryGetValue(key, out var valor)) return 0;
        if (valor is JsonElement elem)
            return elem.ValueKind == JsonValueKind.Number ? elem.GetInt32() : int.Parse(elem.GetString() ?? "0");
        return Convert.ToInt32(valor);
    }

    private string ObtenerColorRol(string nombreRol)
    {
        // Generar colores consistentes basados en el nombre
        return nombreRol.ToLower() switch
        {
            string n when n.Contains("admin") => "bg-danger",
            string n when n.Contains("gerente") || n.Contains("manager") => "bg-primary",
            string n when n.Contains("supervisor") => "bg-warning text-dark",
            string n when n.Contains("editor") || n.Contains("vendedor") => "bg-success",
            string n when n.Contains("usuario") || n.Contains("user") => "bg-info",
            string n when n.Contains("invitado") || n.Contains("guest") => "bg-secondary",
            _ => "bg-primary"
        };
    }
}