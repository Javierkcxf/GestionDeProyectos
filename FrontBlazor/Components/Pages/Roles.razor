@page "/roles"
@using FrontendBlazorApi.Models
@using FrontendBlazorApi.Servicios
@using FrontendBlazorApi.Components
@using System.Text.Json
@inherits PaginaAutenticada
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject ServicioApiGenerico servicioApi
@inject IJSRuntime JS

<PageTitle>Gestión de Roles</PageTitle>

<div class="container-fluid py-4">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-shield-lock me-2"></i>Gestión de Roles
        </h2>
    </div>

    <!-- Mensajes -->
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @estiloMensaje alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi @iconoMensaje me-2"></i>@mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    <!-- Barra de herramientas -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-primary btn-sm" @onclick="CargarRoles" disabled="@cargando">
                    <i class="bi bi-arrow-clockwise me-1"></i> Recargar Roles
                </button>
                <button class="btn btn-warning btn-sm" @onclick="LimpiarFormulario" disabled="@cargando">
                    <i class="bi bi-eraser me-1"></i> Limpiar Formulario
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Columna izquierda: Formulario -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-shield-plus me-2"></i>
                        @(modoEdicion ? "Editar Rol" : "Nuevo Rol")
                    </h5>
                </div>
                <div class="card-body">
                    <EditForm Model="rolActual" OnValidSubmit="GuardarRol" FormName="formRol">
                        <DataAnnotationsValidator />

                        <!-- ID (solo en modo edición) -->
                        @if (modoEdicion)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted">
                                    <i class="bi bi-hash me-1"></i> ID
                                </label>
                                <input type="text" class="form-control" value="@rolActual.Id" disabled />
                            </div>
                        }

                        <!-- Nombre del Rol -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-shield"></i> Nombre del Rol
                            </label>
                            <InputText class="form-control" @bind-Value="rolActual.Nombre"
                                       placeholder="Ej: Administrador, Editor, etc." />
                            <ValidationMessage For="() => rolActual.Nombre" />
                            <small class="text-muted">
                                Define el nombre único del rol en el sistema
                            </small>
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn @(modoEdicion ? "btn-warning" : "btn-success") shadow-sm" disabled="@cargando">
                                <i class="bi @(modoEdicion ? "bi-pencil-square" : "bi-plus-circle") me-1"></i>
                                @(cargando ? "Procesando..." : modoEdicion ? "Actualizar Rol" : "Crear Rol")
                            </button>

                            @if (modoEdicion)
                            {
                                <button type="button" class="btn btn-secondary" @onclick="LimpiarFormulario" disabled="@cargando">
                                    <i class="bi bi-x-circle me-1"></i> Cancelar
                                </button>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>

            <!-- Card informativo -->
            <div class="card shadow-sm border-0">
                <div class="card-body bg-light">
                    <h6 class="text-primary mb-3">
                        <i class="bi bi-info-circle me-1"></i>Información sobre Roles
                    </h6>
                    <small class="text-muted">
                        <strong>¿Qué son los roles?</strong><br/>
                        Los roles son grupos de permisos que se asignan a los usuarios para controlar su acceso al sistema.<br/><br/>
                        
                        <strong>Buenas prácticas:</strong><br/>
                        • Use nombres descriptivos y claros<br/>
                        • No cree roles duplicados<br/>
                        • Mantenga la lista de roles organizada<br/>
                        • Asigne permisos específicos a cada rol<br/><br/>
                        
                        <strong>Ejemplos comunes:</strong><br/>
                        Administrador, Editor, Supervisor, Usuario Básico
                    </small>
                </div>
            </div>
        </div>

        <!-- Columna derecha: Tabla de Roles -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-table me-2"></i>Listado de Roles
                    </h5>
                    <span class="badge bg-light text-primary">
                        @roles.Count roles
                    </span>
                </div>
                <div class="card-body p-0">
                    @if (cargando)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2 text-muted">Cargando roles...</p>
                        </div>
                    }
                    else if (roles == null || !roles.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-shield-slash text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-3 mb-0">No hay roles registrados</p>
                            <small class="text-muted">Cree el primer rol usando el formulario</small>
                        </div>
                    }
                    else
                    {
                        <!-- Filtro de búsqueda -->
                        <div class="p-3 border-bottom bg-light">
                            <input type="text" class="form-control" placeholder="🔍 Buscar rol por nombre..." 
                                   @bind="filtroTexto" @bind:event="oninput" />
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0 align-middle">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 80px;">
                                            <i class="bi bi-hash me-1"></i>ID
                                        </th>
                                        <th>
                                            <i class="bi bi-shield me-1"></i>Nombre del Rol
                                        </th>
                                        <th class="text-center" style="width: 120px;">
                                            <i class="bi bi-gear me-1"></i>Acciones
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rol in RolesFiltrados)
                                    {
                                        <tr>
                                            <td class="fw-bold text-muted">
                                                #@rol.Id
                                            </td>
                                            <td>
                                                <span class="badge @ObtenerColorRol(rol.Nombre) fs-6 px-3 py-2">
                                                    <i class="bi bi-shield-check me-1"></i>@rol.Nombre
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-warning" 
                                                            @onclick="() => CargarParaEditar(rol)"
                                                            title="Editar rol" 
                                                            disabled="@cargando">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" 
                                                            @onclick="() => EliminarRol(rol.Id)"
                                                            title="Eliminar rol" 
                                                            disabled="@cargando">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary">
                                Mostrando @RolesFiltrados.Count() de @roles.Count roles
                            </span>
                            @if (!string.IsNullOrEmpty(filtroTexto))
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => filtroTexto = string.Empty">
                                    <i class="bi bi-x-circle me-1"></i>Limpiar filtro
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Card de advertencia si no hay roles -->
            @if (!roles!.Any() && !cargando)
            {
                <div class="alert alert-warning mt-3 shadow-sm">
                    <h6 class="alert-heading">
                        <i class="bi bi-exclamation-triangle me-2"></i>Sistema sin roles configurados
                    </h6>
                    <p class="mb-0">
                        No hay roles en el sistema. Los roles son fundamentales para el control de acceso.
                        Por favor, cree al menos un rol de "Administrador" para comenzar.
                    </p>
                </div>
            }
        </div>
    </div>
</div>
