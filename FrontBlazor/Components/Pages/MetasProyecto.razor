@page "/metas_proyecto"

@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@using System.Text.Json
@inject IHttpClientFactory fabricaHttp
@using FrontendBlazorApi.Servicios
@inject ServicioApiGenerico servicioApi
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Meta Proyecto</PageTitle>

<h3>Gestión de Meta-Proyecto</h3>

<div class="mb-3 d-flex gap-2">
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarMetaProyectos">Mostrar todos</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso" role="alert">@mensaje</div>
}

<h4>Formulario de Relación Meta-Proyecto</h4>

<EditForm Model="MetaProyectoActual" OnValidSubmit="GuardarMetaProyecto">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label fw-bold">Meta</label>
            <InputSelect class="form-select" @bind-Value="MetaProyectoActual.IdMeta">
                <option value="0">-- Seleccione Meta --</option>
                @foreach (var m in listaMetas)
                {
                    <option value="@m.Id">@m.Titulo (ID: @m.Id)</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-bold">Proyecto</label>
            <InputSelect class="form-select" @bind-Value="MetaProyectoActual.IdProyecto">
                <option value="0">-- Seleccione Proyecto --</option>
                @foreach (var p in listaProyectos)
                {
                    <option value="@p.Id">@p.Titulo (ID: @p.Id)</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-4">
            <label class="form-label">Fecha de Asociación</label>
            <InputDate class="form-control" @bind-Value="MetaProyectoActual.FechaAsociacion" TValue="DateTime?" />
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarMetaProyecto" disabled="@(!existeMetaProyecto)">Eliminar</button>
    </div>
</EditForm>

<hr />

@if (cargando)
{
    <div class="alert alert-info">Cargando MetaProyectos...</div>
}
else if (listaMetaProyectos.Count == 0)
{
    <div class="alert alert-warning">No hay MetaProyectos Meta-Proyecto registradas.</div>
}
else
{
    <table class="table table-striped text-white">
        <thead>
            <tr>
                <th>Meta</th>
                <th>Proyecto</th>
                <th>Fecha Asociación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in listaMetaProyectos)
            {
                <tr>
                    <td>@listaMetas.FirstOrDefault(m => m.Id == r.IdMeta)?.Titulo</td>
                    <td>@listaProyectos.FirstOrDefault(p => p.Id == r.IdProyecto)?.Titulo</td>
                    <td>@r.FechaAsociacion?.ToString("yyyy-MM-dd")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="@(() => CargarEnFormulario(r))">
                            Cargar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Meta_Proyecto> listaMetaProyectos = new();
    private List<Proyecto> listaProyectos = new();
    private List<MetaEstrategica> listaMetas = new();

    private Meta_Proyecto MetaProyectoActual = new();
    private bool existeMetaProyecto = false;
    private string textoBotonGuardar = "Crear";

    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;

    private const string urlProcedimientos = "api/procedimientos/ejecutarsp";
    private const string urlProyecto = "api/proyecto";
    private const string urlMeta = "api/metaestrategica";
    private const string urlBaseApi = "api/meta_proyecto";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarProyectos();
            await CargarMetas();
            await CargarMetaProyectos();
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task CargarProyectos()
    {
        var cliente = await servicioApi.CrearClienteApiConTokenAsync();
        var resp = await cliente.GetFromJsonAsync<RespuestaApi<List<Proyecto>>>(urlProyecto);
        listaProyectos = resp?.Datos ?? new();
    }

    private async Task CargarMetas()
    {
        var cliente = await servicioApi.CrearClienteApiConTokenAsync();
        var resp = await cliente.GetFromJsonAsync<RespuestaApi<List<MetaEstrategica>>>(urlMeta);
        listaMetas = resp?.Datos ?? new();
    }

    private async Task CargarMetaProyectos()
    {
        try
        {
            cargando = true;
            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var resp = await cliente.GetFromJsonAsync<RespuestaApi<List<Meta_Proyecto>>>(urlBaseApi);
            listaMetaProyectos = resp?.Datos ?? new();
            mensaje = $"Se cargaron {listaMetaProyectos.Count} MetaProyectos.";
            claseAviso = "alert alert-success";
        }
        catch (Exception e)
        {
            mensaje = $"Error al cargar MetaProyectos: {e.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarMetaProyecto()
    {
        if (existeMetaProyecto)
            await ActualizarMetaProyecto();
        else
            await CrearMetaProyecto();
    }

private async Task CrearMetaProyecto()
{
    try
    {
        var parametros = new Dictionary<string, object?>
        {
            { "nombreSP", "sp_InsertarMetaProyecto" },
            { "@IdMeta", MetaProyectoActual.IdMeta },
            { "@IdProyecto", MetaProyectoActual.IdProyecto },
            { "@FechaAsociacion", MetaProyectoActual.FechaAsociacion }
        };

        var cliente = await servicioApi.CrearClienteApiConTokenAsync();
        var respuesta = await cliente.PostAsJsonAsync("api/procedimientos/ejecutarsp", parametros);

        if (respuesta.IsSuccessStatusCode)
        {
            mensaje = "✅ Asociación Meta-Proyecto creada exitosamente.";
            claseAviso = "alert alert-success";
            await CargarMetaProyectos(); 
            LimpiarFormulario();
        }
        else
        {
            var error = await respuesta.Content.ReadAsStringAsync();
            mensaje = $"❌ Error al crear la asociación: {error}";
            claseAviso = "alert alert-danger";
        }
    }
    catch (Exception ex)
    {
        mensaje = $"❌ Error al ejecutar el procedimiento: {ex.Message}";
        claseAviso = "alert alert-danger";
    }
}

private async Task ActualizarMetaProyecto()
{
    try
    {
        var parametros = new Dictionary<string, object?>
        {
            { "nombreSP", "sp_ActualizarMetaProyecto" },
            { "@IdMeta", MetaProyectoActual.IdMeta },
            { "@IdProyecto", MetaProyectoActual.IdProyecto },
            { "@FechaAsociacion", MetaProyectoActual.FechaAsociacion }
        };

        var cliente = await servicioApi.CrearClienteApiConTokenAsync();
        var respuesta = await cliente.PostAsJsonAsync("api/procedimientos/ejecutarsp", parametros);

        if (respuesta.IsSuccessStatusCode)
        {
            mensaje = "✅ Asociación Meta-Proyecto actualizada correctamente.";
            claseAviso = "alert alert-success";
            await CargarMetaProyectos();
            LimpiarFormulario();
        }
        else
        {
            var error = await respuesta.Content.ReadAsStringAsync();
            mensaje = $"❌ Error al actualizar la asociación: {error}";
            claseAviso = "alert alert-danger";
        }
    }
    catch (Exception ex)
    {
        mensaje = $"❌ Error al ejecutar procedimiento: {ex.Message}";
        claseAviso = "alert alert-danger";
    }
}

    private async Task EliminarMetaProyecto()
    {
        try
        {
            var parametros = new Dictionary<string, object?>
            {
                { "nombreSP", "sp_EliminarMetaProyecto" },
                { "@IdMeta", MetaProyectoActual.IdMeta },
                { "@IdProyecto", MetaProyectoActual.IdProyecto }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var resp = await cliente.PostAsJsonAsync(urlProcedimientos, parametros);

            if (resp.IsSuccessStatusCode)
            {
                mensaje = "✅ Relación eliminada correctamente.";
                claseAviso = "alert alert-success";
                await CargarMetaProyectos();
                LimpiarFormulario();
            }
            else
            {
                mensaje = "❌ Error al eliminar relación.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"❌ Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private void CargarEnFormulario(Meta_Proyecto r)
    {
        MetaProyectoActual = new Meta_Proyecto
        {
            IdMeta = r.IdMeta,
            IdProyecto = r.IdProyecto,
            FechaAsociacion = r.FechaAsociacion
        };

        existeMetaProyecto = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Relación cargada en el formulario.";
        claseAviso = "alert alert-info";
    }

    private void LimpiarFormulario()
    {
        MetaProyectoActual = new Meta_Proyecto();
        existeMetaProyecto = false;
        textoBotonGuardar = "Crear";
        mensaje = "";
        claseAviso = "alert alert-info";
    }

    private async Task ProbarConexion()
    {
        var cliente = await servicioApi.CrearClienteApiConTokenAsync();
        var resp = await cliente.GetAsync(urlBaseApi);
        if (resp.IsSuccessStatusCode)
        {
            mensaje = "✅ Conexión exitosa con la API.";
            claseAviso = "alert alert-success";
        }
        else
        {
            mensaje = "❌ Error al conectar con la API.";
            claseAviso = "alert alert-danger";
        }
    }
}