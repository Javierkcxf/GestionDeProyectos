        }
    }

    private void CargarEnFormulario(Entregable e)
    {
        entregableActual = new Entregable
        {
            Id = e.Id,
            Codigo = e.Codigo,
            Titulo = e.Titulo,
            Descripcion = e.Descripcion,
            // Removed IdResponsable field
            FechaInicio = e.FechaInicio,
            FechaFinPrevista = e.FechaFinPrevista,
            FechaModificacion = e.FechaModificacion,
            FechaFinalizacion = e.FechaFinalizacion
        };

        existeEntregable = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Entregable cargado en el formulario.";
        claseAviso = "alert alert-info";
    }

    private void LimpiarMensajes()
    {
        mensaje = "";
        claseAviso = "alert alert-info";
    }

    private void LimpiarFormulario()
    {
        entregableActual = new Entregable();
        existeEntregable = false;
        textoBotonGuardar = "Crear";
        responsableSeleccionadoId = 0;
        archivoSeleccionadoId = 0;
        LimpiarMensajes();
    }

    private int ObtenerInt(Dictionary<string, object> dict, string key)
    {
        if (!dict.TryGetValue(key, out var valor)) return 0;

        if (valor is JsonElement elem)
            return elem.ValueKind == JsonValueKind.Number ? elem.GetInt32() : 0;

        return Convert.ToInt32(valor);
    }

    private string ObtenerString(Dictionary<string, object> dict, string key)
    {
        if (!dict.TryGetValue(key, out var valor)) return "";

        if (valor is JsonElement elem)
            return elem.ValueKind == JsonValueKind.String ? elem.GetString() ?? "" : elem.ToString();

        return valor?.ToString() ?? "";
    }

    private async Task GuardarResponsableEntregable()
    {
        if (entregableActual.Id <= 0)
        {
            mensaje = "Debe seleccionar un entregable primero.";
            claseAviso = "alert alert-warning";
            return;
        }

        if (responsableEntregableActual.IdResponsable <= 0)
        {
            mensaje = "Debe seleccionar un responsable.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            responsableEntregableActual.IdEntregable = entregableActual.Id;

            var cliente = fabricaHttp.CreateClient("Api");
            var respuesta = await cliente.PostAsJsonAsync(urlResponsableEntregable, responsableEntregableActual);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Responsable asignado correctamente.";
                claseAviso = "alert alert-success";
                await CargarResponsablesEntregables();
                responsableEntregableActual = new Responsable_Entregable();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo asignar el responsable. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al asignar responsable: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ConfirmarEliminarResponsable(int idResponsable, int idEntregable)
    {
        var titulo = listaResponsables.FirstOrDefault(r => r.Id == idResponsable)?.Nombre ?? idResponsable.ToString();
        var confirmar = await js.InvokeAsync<bool>("confirm", $"¿Estás seguro que deseas eliminar al responsable '{titulo}' (ID {idResponsable}) de este entregable (ID {idEntregable})?");
        if (!confirmar) return;
        await EliminarResponsableEntregable(idResponsable, idEntregable);
    }

    private async Task ConfirmarEliminarEntregable()
    {
        if (entregableActual == null || entregableActual.Id <= 0)
        {
            mensaje = "Debe seleccionar un entregable válido.";
            claseAviso = "alert alert-warning";
            return;
        }

        var nombre = !string.IsNullOrWhiteSpace(entregableActual.Titulo) ? entregableActual.Titulo : entregableActual.Codigo;
        var confirmar = await js.InvokeAsync<bool>("confirm", $"¿Estás seguro que deseas eliminar el entregable '{nombre}' (ID {entregableActual.Id})?");
        if (!confirmar) return;
        await EliminarEntregable();
    }

    private async Task EliminarResponsableEntregable(int idResponsable, int idEntregable)
    {
        if (idResponsable <= 0 || idEntregable <= 0)
        {
            mensaje = "Debe indicar un responsable y entregable válidos.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var cliente = fabricaHttp.CreateClient("Api");

            string tabla = "responsable_entregable";
            string esquema = "dbo";

            // Use composite key path like other components: IdResponsable,IdEntregable/{val1},{val2}
            var ruta = $"{urlResponsableEntregable}/IdResponsable,IdEntregable/{idResponsable},{idEntregable}?tabla={tabla}&esquema={esquema}";
            var respuesta = await cliente.DeleteAsync(ruta);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Responsable removido correctamente.";
                claseAviso = "alert alert-success";
                await CargarResponsablesEntregables();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo remover el responsable. Detalle: {detalle}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception error)
        {
            mensaje = $"Error al remover responsable: {error.Message}";
            claseAviso = "alert alert-danger";
        }
    }
