@page "/actividades"
@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@using System.Text.Json
@inject IHttpClientFactory fabricaHttp
@using FrontendBlazorApi.Servicios
@inject ServicioApiGenerico servicioApi
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Actividades</PageTitle>

<h3>Gestión de Actividades</h3>

<div class="mb-3 d-flex gap-2">
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarActividades">Mostrar todas</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>

<div class="mb-3">
    <label for="idBusqueda">Buscar por ID:</label>
    <InputNumber id="idBusqueda" @bind-Value="idBusqueda" class="form-control" />
    <button class="btn btn-primary mt-2" @onclick="BuscarActividad">Buscar</button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso" role="alert">@mensaje</div>
}

<h4>Formulario de Actividad</h4>

<EditForm Model="actividadActual" OnValidSubmit="GuardarSegunActividad" FormName="ActividadForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label fw-bold">
                <i class="bi bi-box text-primary"></i> Entregable
            </label>
            <InputSelect class="form-select" @bind-Value="actividadActual.IdEntregable">
                <option value="0">-- Seleccione --</option>
                @foreach (var e in listaEntregables)
                {
                    <option value="@e.Id">@e.Titulo (ID: @e.Id)</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-4">
            <label class="form-label">Título</label>
            <InputText class="form-control" @bind-Value="actividadActual.Titulo" />
        </div>

        <div class="col-md-5">
            <label class="form-label">Descripción</label>
            <InputTextArea class="form-control" @bind-Value="actividadActual.Descripcion" rows="2" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Fecha Inicio</label>
            <InputDate class="form-control" @bind-Value="actividadActual.FechaInicio" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Fecha Fin Prevista</label>
            <InputDate class="form-control" @bind-Value="actividadActual.FechaFinPrevista" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Fecha Modificación</label>
            <InputDate class="form-control" @bind-Value="actividadActual.FechaModificacion" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Fecha Finalización</label>
            <InputDate class="form-control" @bind-Value="actividadActual.FechaFinalizacion" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Prioridad</label>
            <InputNumber class="form-control" @bind-Value="actividadActual.Prioridad" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Porcentaje Avance (%)</label>
            <InputNumber class="form-control" @bind-Value="actividadActual.PorcentajeAvance" />
        </div>
    </div>

    <div class="mt-3 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarActividad" disabled="@(!existeActividad)">Eliminar</button>
    </div>
</EditForm>

<hr />

@if (cargando)
{
    <div class="table-loading">Cargando Actividades...</div>
}
else if (listaActividades.Count == 0)
{
    <div class="alert alert-info">
        <strong>ℹ️</strong> No hay Actividades disponibles.
    </div>
}
else
{
    <div class="table-container">
        <table class="table table-striped text-white">
            <thead>
                <tr>
                    <th>Entregable</th>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Inicio</th>
                    <th>Fin Prevista</th>
                    <th>Modificación</th>
                    <th>Finalización</th>
                    <th>Prioridad</th>
                    <th>Avance (%)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in listaActividades)
                {
                    <tr>
                        <td>@listaEntregables.FirstOrDefault(e => e.Id == a.IdEntregable)?.Titulo</td>
                        <td>@a.Titulo</td>
                        <td>@a.Descripcion</td>
                        <td data-date>@a.FechaInicio.ToString("yyyy-MM-dd")</td>
                        <td data-date>@a.FechaFinPrevista.ToString("yyyy-MM-dd")</td>
                        <td data-date>@(a.FechaModificacion?.ToString("yyyy-MM-dd"))</td>
                        <td data-date>@(a.FechaFinalizacion?.ToString("yyyy-MM-dd"))</td>
                        <td>@a.Prioridad</td>
                        <td>@a.PorcentajeAvance</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="@(() => CargarEnFormulario(a))">Cargar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Actividad> listaActividades = new();
    private List<Entregable> listaEntregables = new();

    [SupplyParameterFromForm]
    private Actividad actividadActual { get; set; } = new();

    private bool existeActividad = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;

    private const string urlBaseApi = "api/actividad";
    private const string urlProcedimientos = "api/procedimientos/ejecutarsp";
    private const string urlEntregable = "api/entregable";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarActividades();
            await CargarEntregables();
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task CargarEntregables()
    {
        try
        {
            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Entregable>>>(urlEntregable);
            listaEntregables = respuesta?.Datos ?? new();
        }
        catch { }
    }

    private async Task CargarActividades()
    {
        try
        {
            cargando = true;
            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Actividad>>>(urlBaseApi);
            listaActividades = respuesta?.Datos ?? new();
            mensaje = $"Se cargaron {listaActividades.Count} Actividad(es).";
            claseAviso = "alert alert-success";
        }
        catch (Exception e)
        {
            mensaje = $"Error al listar Actividades: {e.Message}";
            claseAviso = "alert alert-danger";
        }
        finally { cargando = false; }
    }

    private int idBusqueda;
    private async Task BuscarActividad()
    {
        try
        {
            var consulta = new
            {
                consulta = "SELECT * FROM Actividad WHERE Id = @Id",
                parametros = new { Id = idBusqueda }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.PostAsJsonAsync("api/consultas/ejecutarconsultaparametrizada", consulta);

            if (respuesta.IsSuccessStatusCode)
            {
                var resultado = await respuesta.Content.ReadFromJsonAsync<JsonElement>();
                if (resultado.TryGetProperty("resultados", out var datos) && datos.GetArrayLength() > 0)
                {
                    var a = datos[0];
                    actividadActual = new Actividad
                    {
                        Id = a.GetProperty("Id").GetInt32(),
                        IdEntregable = a.GetProperty("IdEntregable").GetInt32(),
                        Titulo = a.GetProperty("Titulo").GetString(),
                        Descripcion = a.TryGetProperty("Descripcion", out var d) ? d.GetString() : null,
                        FechaInicio = a.GetProperty("FechaInicio").GetDateTime(),
                        FechaFinPrevista = a.GetProperty("FechaFinPrevista").GetDateTime(),
                        FechaModificacion = a.GetProperty("FechaModificacion").ValueKind == JsonValueKind.Null ? null : a.GetProperty("FechaModificacion").GetDateTime(),
                        FechaFinalizacion = a.GetProperty("FechaFinalizacion").ValueKind == JsonValueKind.Null ? null : a.GetProperty("FechaFinalizacion").GetDateTime(),
                        Prioridad = a.GetProperty("Prioridad").GetInt32(),
                        PorcentajeAvance = a.GetProperty("PorcentajeAvance").GetInt32()
                    };
                    existeActividad = true;
                    textoBotonGuardar = "Actualizar";
                    claseAviso = "alert alert-success";
                }
                else
                {
                    mensaje = "Actividad no encontrada.";
                    claseAviso = "alert alert-warning";
                }
            }
            else
            {
                mensaje = $"Error al buscar Actividad: {respuesta.ReasonPhrase}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al buscar Actividad: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task GuardarSegunActividad()
    {
        if (existeActividad) await ActualizarActividad();
        else await CrearActividad();
    }

    private async Task CrearActividad()
    {
        try
        {
            var parametros = new Dictionary<string, object?>
            {
                { "nombreSP", "sp_InsertarActividad" },
                { "@IdEntregable", actividadActual.IdEntregable },
                { "@Titulo", actividadActual.Titulo },
                { "@Descripcion", actividadActual.Descripcion },
                { "@FechaInicio", actividadActual.FechaInicio },
                { "@FechaFinPrevista", actividadActual.FechaFinPrevista },
                { "@FechaModificacion", actividadActual.FechaModificacion },
                { "@FechaFinalizacion", actividadActual.FechaFinalizacion },
                { "@Prioridad", actividadActual.Prioridad },
                { "@PorcentajeAvance", actividadActual.PorcentajeAvance }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.PostAsJsonAsync(urlProcedimientos, parametros);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "✅ Actividad insertada exitosamente (SP ejecutado).";
                claseAviso = "alert alert-success";
                await CargarActividades();
                LimpiarFormulario();
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"❌ Error al ejecutar SP: {error}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"❌ Error al ejecutar procedimiento: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ActualizarActividad()
    {
        if (actividadActual.Id <= 0)
        {
            mensaje = "Debe seleccionar una actividad válida para actualizar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var parametros = new Dictionary<string, object?>
            {
                { "nombreSP", "sp_ActualizarActividad" },
                { "@Id", actividadActual.Id },
                { "@IdEntregable", actividadActual.IdEntregable },
                { "@Titulo", actividadActual.Titulo },
                { "@Descripcion", actividadActual.Descripcion },
                { "@FechaInicio", actividadActual.FechaInicio },
                { "@FechaFinPrevista", actividadActual.FechaFinPrevista },
                { "@FechaModificacion", actividadActual.FechaModificacion },
                { "@FechaFinalizacion", actividadActual.FechaFinalizacion },
                { "@Prioridad", actividadActual.Prioridad },
                { "@PorcentajeAvance", actividadActual.PorcentajeAvance }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.PostAsJsonAsync(urlProcedimientos, parametros);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "✅ Actividad actualizada exitosamente (SP ejecutado).";
                claseAviso = "alert alert-success";
                await CargarActividades();
                LimpiarFormulario();
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"❌ Error al actualizar actividad: {error}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"❌ Error al ejecutar procedimiento de actualización: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task EliminarActividad()
    {
        if (actividadActual.Id <= 0)
        {
            mensaje = "Debe seleccionar una actividad válida para eliminar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var parametros = new Dictionary<string, object?>
            {
                { "nombreSP", "sp_EliminarActividad" },
                { "@Id", actividadActual.Id }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.PostAsJsonAsync(urlProcedimientos, parametros);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "✅ Actividad eliminada correctamente (SP ejecutado).";
                claseAviso = "alert alert-success";
                await CargarActividades();
                LimpiarFormulario();
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"❌ Error al eliminar actividad: {error}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"❌ Error al ejecutar procedimiento de eliminación: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ProbarConexion()
    {
        try
        {
            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.GetAsync(urlBaseApi);
            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "✅ Conexión exitosa con la API.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = "❌ Error: Endpoint no disponible.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private void CargarEnFormulario(Actividad a)
    {
        actividadActual = new Actividad
        {
            Id = a.Id,
            IdEntregable = a.IdEntregable,
            Titulo = a.Titulo,
            Descripcion = a.Descripcion,
            FechaInicio = a.FechaInicio,
            FechaFinPrevista = a.FechaFinPrevista,
            FechaModificacion = a.FechaModificacion,
            FechaFinalizacion = a.FechaFinalizacion,
            Prioridad = a.Prioridad,
            PorcentajeAvance = a.PorcentajeAvance
        };

        existeActividad = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Actividad cargada en el formulario.";
        claseAviso = "alert alert-info";
    }

    private void LimpiarFormulario()
    {
        actividadActual = new Actividad();
        existeActividad = false;
        textoBotonGuardar = "Crear";
        mensaje = "";
        claseAviso = "alert alert-info";
    }
}