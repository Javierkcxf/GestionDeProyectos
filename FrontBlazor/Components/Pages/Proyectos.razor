        private async Task BuscarProyecto()
        {
            try
            {
                var consulta = new
                {
                    consulta = "SELECT * FROM Proyecto WHERE Id = @Id",
                    parametros = new { Id = idBusqueda }
                };

                var cliente = fabricaHttp.CreateClient("Api");
                var respuestaHttp = await cliente.PostAsJsonAsync("api/consultas/ejecutarconsultaparametrizada", consulta);

                if (respuestaHttp.IsSuccessStatusCode)
                {
                    var resultado = await respuestaHttp.Content.ReadFromJsonAsync<JsonElement>();
                    Console.WriteLine(resultado.ToString());

                    if (resultado.TryGetProperty("resultados", out var datos) && datos.GetArrayLength() > 0)
                    {
                        var primerProyecto = datos[0];
                        ProyectoActual = new Proyecto
                        {
                            Id = primerProyecto.GetProperty("Id").GetInt32(),
                            IdProyectoPadre = primerProyecto.GetProperty("IdProyectoPadre").GetInt32(),
                            IdResponsable = primerProyecto.GetProperty("IdResponsable").GetInt32(),
                            IdTipoProyecto = primerProyecto.GetProperty("IdTipoProyecto").GetInt32(),
                            Codigo = primerProyecto.GetProperty("Codigo").GetString() ?? string.Empty,
                            Titulo = primerProyecto.GetProperty("Titulo").GetString() ?? string.Empty,
                            Descripcion = primerProyecto.GetProperty("Descripcion").GetString() ?? string.Empty,
                            FechaInicio = primerProyecto.GetProperty("FechaInicio").GetDateTime(),
                            FechaFinPrevista = primerProyecto.GetProperty("FechaFinPrevista").GetDateTime(),
                            FechaModificacion = primerProyecto.GetProperty("FechaModificacion").GetDateTime(),
                            FechaFinalizacion = primerProyecto.GetProperty("FechaFinalizacion").GetDateTime(),
                        };

                        existeProyecto = true;
                        textoBotonGuardar = "Actualizar";
                        mensaje = string.Empty;
                        claseAviso = "alert alert-success";
                    }
                    else
                    {
                        mensaje = "Proyecto no encontrado.";
                        claseAviso = "alert alert-warning";
                    }
                }
                else
                {
                    var detalle = await respuestaHttp.Content.ReadAsStringAsync();
                    mensaje = $"Error: {respuestaHttp.ReasonPhrase} - {detalle}";
                    claseAviso = "alert alert-danger";
                }
            }
            catch (Exception ex)
            {
                mensaje = $"Error al buscar Proyecto: {ex.Message}";
                claseAviso = "alert alert-danger";
            }
        }

