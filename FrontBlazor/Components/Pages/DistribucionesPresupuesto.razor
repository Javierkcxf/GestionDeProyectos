@page "/distribuciones_presupuesto"

@using System.Net.Http.Json
@using FrontendBlazorApi.Models
@using System.Text.Json
@inject IHttpClientFactory fabricaHttp
@using FrontendBlazorApi.Servicios
@inject ServicioApiGenerico servicioApi
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Distribuciones de Presupuesto</PageTitle>

<h3>Gestión de Distribuciones de Presupuesto</h3>

<div class="mb-3 d-flex gap-2">
    <button type="button" class="btn btn-outline-secondary" @onclick="ProbarConexion">Probar conexión</button>
    <button type="button" class="btn btn-outline-primary" @onclick="CargarDistribuciones">Mostrar todas</button>
    <button type="button" class="btn btn-outline-dark" @onclick="LimpiarFormulario">Limpiar</button>
</div>

<div class="mb-3">
    <label for="idBusqueda">Buscar por ID:</label>
    <InputNumber id="idBusqueda" @bind-Value="idBusqueda" class="form-control" />
    <button class="btn btn-primary mt-2" @onclick="BuscarDistribucion">Buscar</button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="@claseAviso" role="alert">@mensaje</div>
}

<h4>Formulario de Distribución</h4>

<EditForm Model="distribucionActual" OnValidSubmit="GuardarSegunDistribucion" FormName="DistribucionForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label fw-bold">Presupuesto Padre</label>
            <InputSelect class="form-select" @bind-Value="distribucionActual.IdPresupuestoPadre">
                <option value="0">-- Seleccione --</option>
                @foreach (var p in listaPresupuestos)
                {
                    <option value="@p.Id">@p.Id - @p.MontoSolicitado.ToString("C")</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-4">
            <label class="form-label">Proyecto Hijo</label>
            <InputSelect class="form-select" @bind-Value="distribucionActual.IdProyectoHijo">
                <option value="0">-- Seleccione --</option>
                @foreach (var p in listaProyectos)
                {
                    <option value="@p.Id">@p.Titulo (ID: @p.Id)</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-4">
            <label class="form-label">Monto Asignado</label>
            <InputNumber class="form-control" @bind-Value="distribucionActual.MontoAsignado" />
        </div>
    </div>

    <div class="mt-3 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">@textoBotonGuardar</button>
        <button type="button" class="btn btn-danger" @onclick="EliminarDistribucion" disabled="@(!existeDistribucion)">Eliminar</button>
    </div>
</EditForm>

<hr />

@if (cargando)
{
    <div class="table-loading">
        Cargando Distribuciones...
    </div>
}
else if (listaDistribuciones.Count == 0)
{
    <div class="alert alert-info">
        <strong>ℹ️</strong> No hay Distribuciones disponibles.
    </div>
}
else
{
    <div class="table-container">
        <table class="table table-striped text-white">
            <thead>
                <tr>
                    <th>Presupuesto Padre</th>
                    <th>Proyecto Hijo</th>
                    <th>Monto Asignado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in listaDistribuciones)
                {
                    <tr>
                        <td>@listaPresupuestos.FirstOrDefault(p => p.Id == d.IdPresupuestoPadre)?.Id</td>
                        <td>@listaProyectos.FirstOrDefault(p => p.Id == d.IdProyectoHijo)?.Titulo</td>
                        <td>@d.MontoAsignado.ToString("C")</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    @onclick="@(() => CargarEnFormulario(d))">
                                Cargar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<DistribucionPresupuesto> listaDistribuciones = new();
    private List<Presupuesto> listaPresupuestos = new();
    private List<Proyecto> listaProyectos = new();
    [SupplyParameterFromForm]
    private DistribucionPresupuesto distribucionActual { get; set; } = new();

    private bool existeDistribucion = false;
    private string textoBotonGuardar = "Crear";
    private string mensaje = "";
    private string claseAviso = "alert alert-info";
    private bool cargando = false;

    private const string urlBaseApi = "api/distribucionpresupuesto";
    private const string urlProcedimientos = "api/procedimientos/ejecutarsp";
    private const string urlPresupuesto = "api/presupuesto";
    private const string urlProyecto = "api/proyecto";

    private int idBusqueda;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarDistribuciones();
            await CargarProyectos();
            await CargarPresupuestos();
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task CargarDistribuciones()
    {
        try
        {
            cargando = true;
            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<DistribucionPresupuesto>>>(urlBaseApi);
            listaDistribuciones = respuesta?.Datos ?? new();
            mensaje = $"Se cargaron {listaDistribuciones.Count} distribución(es).";
            claseAviso = "alert alert-success";
        }
        catch (Exception e)
        {
            mensaje = $"Error al listar Distribuciones: {e.Message}";
            claseAviso = "alert alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarProyectos()
    {
        try
        {
            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Proyecto>>>(urlProyecto);
            listaProyectos = respuesta?.Datos ?? new();
        }
        catch { }
    }

    private async Task CargarPresupuestos()
    {
        try
        {
            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.GetFromJsonAsync<RespuestaApi<List<Presupuesto>>>(urlPresupuesto);
            listaPresupuestos = respuesta?.Datos ?? new();
        }
        catch { }
    }

    private async Task BuscarDistribucion()
    {
        try
        {
            var consulta = new
            {
                consulta = "SELECT * FROM DistribucionPresupuesto WHERE Id = @Id",
                parametros = new { Id = idBusqueda }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.PostAsJsonAsync("api/consultas/ejecutarconsultaparametrizada", consulta);

            if (respuesta.IsSuccessStatusCode)
            {
                var resultado = await respuesta.Content.ReadFromJsonAsync<JsonElement>();
                if (resultado.TryGetProperty("resultados", out var datos) && datos.GetArrayLength() > 0)
                {
                    var d = datos[0];
                    distribucionActual = new DistribucionPresupuesto
                    {
                        Id = d.GetProperty("Id").GetInt32(),
                        IdPresupuestoPadre = d.GetProperty("IdPresupuestoPadre").GetInt32(),
                        IdProyectoHijo = d.GetProperty("IdProyectoHijo").GetInt32(),
                        MontoAsignado = d.GetProperty("MontoAsignado").GetDecimal()
                    };

                    existeDistribucion = true;
                    textoBotonGuardar = "Actualizar";
                    claseAviso = "alert alert-success";
                }
                else
                {
                    mensaje = "Distribución no encontrada.";
                    claseAviso = "alert alert-warning";
                }
            }
            else
            {
                mensaje = $"Error al buscar Distribución: {respuesta.ReasonPhrase}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al buscar Distribución: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task GuardarSegunDistribucion()
    {
        if (existeDistribucion)
            await ActualizarDistribucion();
        else
            await CrearDistribucion();
    }

    private async Task CrearDistribucion()
    {
        try
        {
            var parametros = new Dictionary<string, object?>
            {
                { "nombreSP", "sp_InsertarDistribucionPresupuesto" },
                { "@IdPresupuestoPadre", distribucionActual.IdPresupuestoPadre },
                { "@IdProyectoHijo", distribucionActual.IdProyectoHijo != 0 ? distribucionActual.IdProyectoHijo : null },
                { "@MontoAsignado", distribucionActual.MontoAsignado }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.PostAsJsonAsync(urlProcedimientos, parametros);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "✅ Distribución insertada exitosamente (SP ejecutado).";
                claseAviso = "alert alert-success";
                await CargarDistribuciones();
                LimpiarFormulario();
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"❌ Error al ejecutar SP: {error}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"❌ Error al ejecutar procedimiento: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ActualizarDistribucion()
    {
        if (distribucionActual.Id <= 0)
        {
            mensaje = "Debe seleccionar una distribución válida para actualizar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var parametros = new Dictionary<string, object?>
            {
                { "nombreSP", "sp_ActualizarDistribucionPresupuesto" },
                { "@Id", distribucionActual.Id },
                { "@IdPresupuestoPadre", distribucionActual.IdPresupuestoPadre },
                { "@IdProyectoHijo", distribucionActual.IdProyectoHijo != 0 ? distribucionActual.IdProyectoHijo : null },
                { "@MontoAsignado", distribucionActual.MontoAsignado }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.PostAsJsonAsync(urlProcedimientos, parametros);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "✅ Distribución actualizada exitosamente (SP ejecutado).";
                claseAviso = "alert alert-success";
                await CargarDistribuciones();
                LimpiarFormulario();
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"❌ Error al actualizar distribución: {error}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"❌ Error al ejecutar procedimiento de actualización: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task EliminarDistribucion()
    {
        if (distribucionActual.Id <= 0)
        {
            mensaje = "Debe seleccionar una distribución válida para eliminar.";
            claseAviso = "alert alert-warning";
            return;
        }

        try
        {
            var parametros = new Dictionary<string, object?>
            {
                { "nombreSP", "sp_EliminarDistribucionPresupuesto" },
                { "@Id", distribucionActual.Id }
            };

            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.PostAsJsonAsync(urlProcedimientos, parametros);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "✅ Distribución eliminada correctamente (SP ejecutado).";
                claseAviso = "alert alert-success";
                await CargarDistribuciones();
                LimpiarFormulario();
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"❌ Error al eliminar distribución: {error}";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"❌ Error al ejecutar procedimiento de eliminación: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private async Task ProbarConexion()
    {
        try
        {
            var cliente = await servicioApi.CrearClienteApiConTokenAsync();
            var respuesta = await cliente.GetAsync(urlBaseApi);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "✅ Conexión exitosa con la API.";
                claseAviso = "alert alert-success";
            }
            else
            {
                mensaje = "❌ Error: Endpoint no disponible.";
                claseAviso = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            claseAviso = "alert alert-danger";
        }
    }

    private void CargarEnFormulario(DistribucionPresupuesto d)
    {
        distribucionActual = new DistribucionPresupuesto
        {
            Id = d.Id,
            IdPresupuestoPadre = d.IdPresupuestoPadre,
            IdProyectoHijo = d.IdProyectoHijo,
            MontoAsignado = d.MontoAsignado
        };

        existeDistribucion = true;
        textoBotonGuardar = "Actualizar";
        mensaje = "Distribución cargada en el formulario.";
        claseAviso = "alert alert-info";
    }

    private void LimpiarFormulario()
    {
        distribucionActual = new DistribucionPresupuesto();
        existeDistribucion = false;
        textoBotonGuardar = "Crear";
        mensaje = "";
        claseAviso = "alert alert-info";
    }
}
